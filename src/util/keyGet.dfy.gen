// Generated by lsc from keyGet.ts

function StringIndexOf(s: string, sub: string): int
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: nat): int
  decreases |s| - from
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFrom(s, sub, from + 1)
}

method keyGet(key1: string, key2: string) returns (res: string)
  ensures ((StringIndexOf(key2, "*") == -1) ==> (res == ""))
  ensures ((|key1| <= StringIndexOf(key2, "*")) ==> (res == ""))
  ensures ((StringIndexOf(key2, "*") >= 0) ==> (StringIndexOf(key2, "*") <= |key1|) ==> (StringIndexOf(key2, "*") <= |key2|) ==> (key1[0..StringIndexOf(key2, "*")] != key2[0..StringIndexOf(key2, "*")]) ==> (res == ""))
{
  var pos := StringIndexOf(key2, "*");
  if (pos == -1) {
    return "";
  }
  if (|key1| > pos) {
    if (key1[0..pos] == key2[0..pos]) {
      return key1[pos..|key1|];
    }
  }
  return "";
}
